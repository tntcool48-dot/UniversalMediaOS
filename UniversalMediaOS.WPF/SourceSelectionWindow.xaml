<Window x:Class="UniversalMediaOS.WPF.SourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Source" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19" Foreground="White" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Master Routing Switchboard" FontSize="26" FontWeight="Black" Foreground="#F8FAFC" Margin="0,0,0,10"/>
        <TextBlock Text="Select the architecture tier you want to use for this request." FontSize="14" Foreground="#94A3B8" Margin="0,0,0,20"/>
        
        <!-- Tier 1: Nyaa P2P -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tier 1: P2P Torrent (Nyaa)" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                <ListBox x:Name="TorrentsList" Grid.Row="1" Background="#0F172A" Foreground="White" BorderThickness="0" Height="150" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Seeders, StringFormat='{}Seeders: {0}'}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" VerticalAlignment="Bottom" Content="Inject Selected Torrent" Background="#10B981" Foreground="Black" FontWeight="Bold" Padding="10" BorderThickness="0" Click="SelectTorrent_Click"/>
            </Grid>
        </Border>

        <!-- Tier 2: Consumet API -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tier 2: Consumet API (Local Node)" FontSize="18" FontWeight="Bold" Foreground="#3B82F6"/>
                    <TextBlock Text="Direct HTTP extraction via localhost:3000 microservice" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Stream via Consumet" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="15,10" BorderThickness="0" Click="ConsumetButton_Click"/>
            </Grid>
        </Border>

        <!-- Tier 3: Web Provider -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tier 3: Web Provider Fallback" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6"/>
                    <TextBlock Text="Embedded browser player using chosen scraper domain" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Launch Web Embed" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Padding="15,10" BorderThickness="0" Click="WebProviderButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
