<Window x:Class="UniversalMediaOS.WPF.SourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Source" Height="360" Width="600" MinHeight="350" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19" Foreground="White" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Select Playback Mode" FontSize="22" FontWeight="Black" Foreground="#F8FAFC"/>
            <TextBlock Text="Choose how you want to watch this episode." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Stream episode" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="Find a usable video and play it directly in the app." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="StreamAutoBtn" Grid.Column="1"
                        Content="Stream" Background="#10B981" Foreground="Black"
                        FontWeight="Bold" Padding="18,8" BorderThickness="0"
                        Cursor="Hand" Click="StreamAutoButton_Click"
                        IsDefault="True"
                        ToolTip="Try automatic sources for direct video playback."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Website — last resort" FontSize="16" FontWeight="Bold" Foreground="#3B82F6"/>
                    <TextBlock Text="Use a website player when direct streaming is unavailable." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="StreamWebViewBtn" Grid.Column="1"
                        Content="Open website" Background="#3B82F6" Foreground="White"
                        FontWeight="Bold" Padding="18,8" BorderThickness="0"
                        Cursor="Hand" Click="StreamWebViewButton_Click"
                        ToolTip="Explicitly open a website player inside the app."/>
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="Cancel" HorizontalAlignment="Right"
                Background="Transparent" Foreground="#64748B"
                FontSize="13" BorderThickness="0" Padding="12,6"
                Cursor="Hand" Click="CancelButton_Click"
                IsCancel="True"
                ToolTip="Close this dialog without starting playback."/>
    </Grid>
</Window>
