<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    
    <!-- Semantic Colors -->
    <!-- Semi-transparent to let DWM Mica shine through -->
    <SolidColorBrush x:Key="BgApp" Color="#FF070A12" po:Freeze="True" />
    <SolidColorBrush x:Key="BgChrome" Color="#F20A0F1D" po:Freeze="True" />
    <SolidColorBrush x:Key="BgPanel" Color="#F2141A2A" po:Freeze="True" />
    <SolidColorBrush x:Key="BgPanelAlt" Color="#FF101827" po:Freeze="True" />
    <SolidColorBrush x:Key="BgElevated" Color="#FF182033" po:Freeze="True" />
    <SolidColorBrush x:Key="BgInput" Color="#FF0F1626" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPrimary" Color="#14B8A6" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2238BDF8" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Success" Color="#10B981" po:Freeze="True" />
    <SolidColorBrush x:Key="Warning" Color="#F59E0B" po:Freeze="True" />
    <SolidColorBrush x:Key="Error" Color="#EF4444" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#2A2A35" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderStrong" Color="#334155" po:Freeze="True" />
    <SolidColorBrush x:Key="FocusBorder" Color="#38BDF8" po:Freeze="True" />

    <SolidColorBrush x:Key="ControlHoverBackground" Color="#263449" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#334155" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentText" Color="#000000" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerText" Color="#000000" po:Freeze="True" />

    <!-- Layout Thicknesses -->
    <Thickness x:Key="SurfaceCardPadding">16</Thickness>
    <Thickness x:Key="AppButtonPadding">14,8</Thickness>
    <Thickness x:Key="NavButtonPadding">12,10</Thickness>
    <Thickness x:Key="AppTextBoxPadding">12,9</Thickness>
    <Thickness x:Key="AppComboBoxPadding">10,7</Thickness>
 
    <Thickness x:Key="CompactInputPadding">8,4</Thickness>
    <sys:Double x:Key="CompactInputHeight">34</sys:Double>

    <!-- Corner Radius Tokens -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <sys:Double x:Key="AppButtonMinHeight">34</sys:Double>
    <sys:Double x:Key="AppInputMinHeight">38</sys:Double>
    <sys:Double x:Key="AppControlFontSize">14</sys:Double>
    <sys:Double x:Key="NavButtonFontSize">14</sys:Double>
    
</ResourceDictionary>
