<UserControl x:Class="UniversalMediaOS.WPF.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:UniversalMediaOS.WPF.ViewModels"
             xmlns:controls="clr-namespace:UniversalMediaOS.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgBase}" CornerRadius="8" Margin="0,0,0,24" Padding="{StaticResource SpaceXs}">
            <Grid>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" 
                         FontSize="16" Padding="{StaticResource SpaceSm}"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Left">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Fuzzy search titles... (e.g. Frieren, Demon Slayer)" 
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="{StaticResource SpaceMd}" 
                           Foreground="{StaticResource TextMuted}" FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" VerticalAlignment="Top" 
                     Foreground="{StaticResource AccentPrimary}" Background="Transparent"
                     BorderThickness="0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Virtualized Results Grid -->
        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="160" Height="240" CornerRadius="8" Margin="8" Background="{StaticResource BgSurface}" ClipToBounds="True">
                        <Border.Effect>
                            <StaticResource ResourceKey="ElevatedPlane"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Poster Image -->
                            <Image controls:AsyncImageLoader.ImageUrl="{Binding CoverImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            
                            <!-- Gradient Overlay for Text Readability -->
                            <Border VerticalAlignment="Bottom" Height="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#E6000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                
                                <Grid Margin="12,0,12,12" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding OfficialTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Hover Overlay -->
                            <Border x:Name="HoverOverlay" Background="{StaticResource HoverOverlay}" Opacity="0">
                                <Button Content="Download" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,8"
                                        Background="{StaticResource AccentPrimary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                            </Border>
                        </Grid>
                        
                        <!-- Hover Triggers -->
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" 
                                                         To="1" Duration="{StaticResource MotionFast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" 
                                                         To="0" Duration="{StaticResource MotionFast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
