<UserControl x:Class="UniversalMediaOS.WPF.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UniversalMediaOS.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="{StaticResource BgApp}">

    <UserControl.Resources>
        <Style x:Key="TagToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#171B29"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#202A3E"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#332DD4BF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"
                             FontSize="16"
                             Height="38">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Search anime series..."
                               Style="{StaticResource SearchPlaceholderText}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="15"/>
                </Grid>

                <Button Grid.Column="1"
                        Content="Search"
                        AutomationProperties.Name="ExecuteSearch"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        ToolTip="Search anime metadata providers."/>
                <Button Grid.Column="2"
                        Content="Cancel"
                        AutomationProperties.Name="Cancel search"
                        Command="{Binding SearchCancelCommand}"
                        Style="{StaticResource DangerButton}"
                        Height="38"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Cancel the current anime search."/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgApp}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Tags" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TagSummary}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="Clear"
                            Command="{Binding ClearTagsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinHeight="28"
                            Padding="10,4"
                            ToolTip="Clear all selected genre and story tags."/>
                    <TextBlock Text="Loading tags..."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="{Binding IsLoadingTags, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Status" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              MinWidth="132"
                              Margin="0,0,12,0"
                              ToolTip="Filter by airing, finished, or upcoming status."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Audio" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AudioFilters}"
                              SelectedItem="{Binding SelectedAudio, Mode=TwoWay}"
                              MinWidth="112"
                              Margin="0,0,12,0"
                              ToolTip="Filter to subbed titles or titles with verified dubbed episode badges."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding SortFilters}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              MinWidth="140"
                              ToolTip="Change the AniList result ordering."/>
                </StackPanel>
                </WrapPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="76"
                              Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding TagFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource TagToggleButtonStyle}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              ToolTip="{Binding ToolTipText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="6,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SearchResults.Count, StringFormat={}{0} results}"
                           Style="{StaticResource CaptionText}"/>
                <TextBlock Text=" - " Foreground="{StaticResource TextMuted}" Margin="4,0"/>
                <TextBlock Text="{Binding ResultsDescription}" Foreground="{StaticResource AccentPrimary}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True"
                         Width="140"
                         Height="3"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource AccentPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <ListBox x:Name="ResultsList"
                 Grid.Row="3"
                 ItemsSource="{Binding SearchResultRows}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="10,16,10,0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="1"
                 VirtualizingPanel.CacheLengthUnit="Page"
                 Loaded="ResultsList_Loaded"
                 SizeChanged="ResultsList_SizeChanged"
                 PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                 ScrollViewer.ScrollChanged="ResultsList_ScrollChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Results}"
                                  Loaded="ResultRow_Loaded">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                        <Button Width="252"
                                Height="404"
                                Margin="0,0,14,14"
                                AutomationProperties.Name="View Details"
                                Command="{Binding DataContext.SelectAnimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ToolTip="Open this anime's landing page.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.82"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Border CornerRadius="8"
                                    Background="{StaticResource BgPanelAlt}"
                                    ClipToBounds="True"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="292"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#241A1430" Offset="0"/>
                                                <GradientStop Color="#FF0A0E1A" Offset="0.48"/>
                                                <GradientStop Color="#3322C55E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Image controls:AsyncImageLoader.ImageUrl="{Binding CoverImageUrl}"
                                               Stretch="{Binding DataContext.SettingsViewModel.PosterStretch, RelativeSource={RelativeSource AncestorType=Window}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding OfficialTitle}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="180">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CoverImageUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="#CC070A12" Padding="8,4" Margin="8">
                                            <TextBlock Foreground="{StaticResource Warning}" FontSize="11" FontWeight="Bold">
                                                <Run Text="* "/><Run Text="{Binding DisplayRating}"/>
                                            </TextBlock>
                                        </Border>
                                        <Button VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                Width="28"
                                                Height="28"
                                                Margin="8"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding FavoriteToolTip}"
                                                Background="#AA070A12"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource Warning}"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="13"
                                                Content="{Binding FavoriteGlyph}"/>
                                        <Border VerticalAlignment="Bottom" Height="84">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#EE070A12" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#553B1B7A" CornerRadius="4" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DisplayStatus}" Foreground="#A78BFA" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding OfficialTitle}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Grid Grid.Row="2" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding DisplayYear}" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding EpisodeCountText}"
                                                       Foreground="{StaticResource AccentPrimary}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <StackPanel Grid.Row="3">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#2214B8A6" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SubBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                                                </Border>
                                                <Border Background="#223B82F6" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding DubBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#93C5FD"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                            <Border Background="#3322C55E" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayGenreOne}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                            </Border>
                                            <Border Background="#338B5CF6" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DisplayGenreTwo}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                            </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Background="Transparent"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="No anime found"
                           Style="{StaticResource DisplayText}"
                           FontSize="24"
                           FontWeight="Black"
                           TextAlignment="Center"/>
                <TextBlock Text="Maybe you are offline, the provider returned no results, or the current filters are too narrow."
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
