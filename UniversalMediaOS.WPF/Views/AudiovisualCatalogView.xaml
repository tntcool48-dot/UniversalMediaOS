<UserControl x:Class="UniversalMediaOS.WPF.Views.AudiovisualCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UniversalMediaOS.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{DynamicResource BgApp}">

    <UserControl.Resources>
        <Style x:Key="CatalogToggleButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaCardButton" TargetType="Button">
            <Setter Property="Width" Value="218"/>
            <Setter Property="Height" Value="356"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{DynamicResource BgPanelAlt}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BgElevated}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="BrowsePanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgChrome}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="18,16">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource DisplayText}" FontSize="26"/>
                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               Visibility="{Binding HasCatalogAttribution, Converter={StaticResource BoolToVisibility}}">
                        <Hyperlink Command="{Binding OpenMetadataAttributionCommand}" Foreground="{DynamicResource AccentPrimary}"><Run Text="{Binding CatalogAttributionText, Mode=OneWay}"/></Hyperlink>
                    </TextBlock>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Discover"
                                Command="{Binding ShowDiscoverCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="84"
                                Margin="0,0,8,0"
                                ToolTip="Return to provider discovery results."/>
                        <Button Content="My Library"
                                AutomationProperties.Name="{Binding HeaderTitle, StringFormat={}{0} library}"
                                Command="{Binding ShowLibraryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="94"
                                Margin="0,0,8,0"
                                ToolTip="Show saved and recently opened titles for this media type."/>
                        <Button Content="Favorites"
                                Command="{Binding ShowFavoritesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                ToolTip="Show favorites for this media type."/>
                        <ToggleButton Content="Arabic dubbed only"
                                      IsChecked="{Binding ArabicOnly, Mode=TwoWay}"
                                      Command="{Binding RefreshCommand}"
                                      Style="{StaticResource CatalogToggleButton}"
                                      Visibility="{Binding IsCartoon, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,8,0"
                                      ToolTip="Show the dedicated Arabic-cartoon lane. Verified means the provider supplied explicit Arabic audio evidence."/>
                        <Button Content="{Binding BrowseButtonText}"
                                Command="{Binding LoadPopularCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="90"
                                Margin="0,0,8,0"
                                ToolTip="Browse the catalog from its first page."/>
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="90"
                                ToolTip="Refresh the current catalog view."/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}"
                                 AutomationProperties.Name="{Binding SearchAutomationName}"
                                 Height="38"
                                 FontSize="15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding SearchPlaceholder}"
                                   Style="{StaticResource SearchPlaceholderText}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="Search"
                            AutomationProperties.Name="{Binding SearchButtonAutomationName}"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            MinWidth="98"
                            Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} titles}"
                               Style="{StaticResource CaptionText}"/>
                    <TextBlock Text=" &#x00B7; " Foreground="{DynamicResource TextMuted}" Margin="4,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource AccentPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressBar IsIndeterminate="True"
                             Width="150"
                             Height="3"
                             HorizontalAlignment="Right"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,12,0,0">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MediaCardButton}"
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Open details and available sources.">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="270"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2414B8A6" Offset="0"/>
                                                    <GradientStop Color="#FF0A0E1A" Offset="0.55"/>
                                                    <GradientStop Color="#338B5CF6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Grid.Background>
                                            <Image controls:AsyncImageLoader.ImageUrl="{Binding PosterUrl}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="20"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PosterUrl}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Padding="7,3"
                                                    CornerRadius="6"
                                                    Background="#CC070A12">
                                                <TextBlock Text="{Binding RatingText}"
                                                           Foreground="{DynamicResource Warning}"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Padding="7,3"
                                                    CornerRadius="6"
                                                    Background="#CC070A12"
                                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="&#x2605;" Foreground="{DynamicResource Warning}" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="11,9">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource SubtitleText}"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding LanguageText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="{Binding YearText}" Style="{StaticResource CaptionText}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding GenreText}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Load more"
                            AutomationProperties.AutomationId="AudiovisualLoadMore"
                            AutomationProperties.Name="Load more titles"
                            Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center"
                            Margin="0,4,14,20" MinWidth="130"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfaceCard}"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyTitle}"
                                   Style="{StaticResource TitleText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyMessage}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="DetailsPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgChrome}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="&#x2190; Back"
                            Command="{Binding CloseDetailsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="88"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedItem.Title}"
                               Style="{StaticResource TitleText}"
                               VerticalAlignment="Center"
                               Margin="14,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2"
                            Content="{Binding FavoriteButtonText}"
                            Command="{Binding ToggleFavoriteCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="126"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Height="360"
                                Background="{DynamicResource BgPanelAlt}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <Image controls:AsyncImageLoader.ImageUrl="{Binding SelectedItem.PosterUrl}"
                                       Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding SelectedItem.Title}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="24"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Library" Style="{StaticResource SubtitleText}" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding LibraryStatuses}"
                                          SelectedItem="{Binding SelectedLibraryStatus, Mode=TwoWay}"
                                          Margin="0,10,0,0"
                                          ToolTip="Track this title independently from the Anime library."/>
                                <Button Content="Save status"
                                        Command="{Binding SaveLibraryStatusCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding ResumeText}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding SelectedItem.Title}" Style="{StaticResource DisplayText}" FontSize="30"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SelectedItem.YearText}" Style="{StaticResource CaptionText}"/>
                            </Border>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SelectedItem.RatingText}" Style="{StaticResource CaptionText}"/>
                            </Border>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SelectedItem.GenreText}" Style="{StaticResource CaptionText}"/>
                            </Border>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SelectedItem.LanguageText}" Style="{StaticResource CaptionText}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding SelectedItem.Overview}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,18"/>
                        <TextBlock Margin="0,0,0,14"
                                   Visibility="{Binding SelectedItem.HasMetadataAttribution, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Command="{Binding OpenMetadataAttributionCommand}" Foreground="{DynamicResource AccentPrimary}"><Run Text="{Binding SelectedItem.MetadataAttributionText, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,14"
                                   Visibility="{Binding SelectedItem.HasPosterAttribution, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Command="{Binding OpenPosterAttributionCommand}" Foreground="{DynamicResource AccentPrimary}">Poster: IMDb</Hyperlink>
                        </TextBlock>

                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <TextBlock Text="Find a source" Style="{StaticResource TitleText}"/>
                                <TextBlock Text="Sources are matched against title, year, media type, season, episode, and preferred language."
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,12"/>
                                <StackPanel Visibility="{Binding SupportsEpisodes, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding EpisodeStatusText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                                 Visibility="{Binding IsLoadingEpisodes, Converter={StaticResource BoolToVisibility}}"/>
                                    <WrapPanel Visibility="{Binding ShowEpisodePicker, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Width="145" Margin="0,0,10,10">
                                            <TextBlock Text="Season" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Seasons}" DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                                                      AutomationProperties.Name="Choose season"/>
                                        </StackPanel>
                                        <StackPanel Width="300" Margin="0,0,0,10">
                                            <TextBlock Text="Episode" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Episodes}" DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}"
                                                      AutomationProperties.Name="Choose episode"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Margin="0,0,0,10"
                                               Visibility="{Binding ShowManualEpisodeNumbers, Converter={StaticResource BoolToVisibility}}">
                                        <Hyperlink Command="{Binding LoadEpisodesCommand}" Foreground="{DynamicResource AccentPrimary}">Retry episode list</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <WrapPanel>
                                    <StackPanel Width="124"
                                                Margin="0,0,10,10"
                                                Visibility="{Binding ShowManualEpisodeNumbers, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Season" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SeasonNumberText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Season number"/>
                                    </StackPanel>
                                    <StackPanel Width="124"
                                                Margin="0,0,10,10"
                                                Visibility="{Binding ShowManualEpisodeNumbers, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Episode" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EpisodeNumberText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Episode number"/>
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,10">
                                        <TextBlock Text="Preferred language" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                                  SelectedItem="{Binding PreferredLanguage, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Button Content="Find sources"
                                            AutomationProperties.Name="Refresh media sources"
                                            Command="{Binding FindSourcesCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="36"
                                            MinWidth="138"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,10"/>
                                    <Button Content="Download season"
                                            Command="{Binding DownloadSeasonCommand}"
                                            Visibility="{Binding ShowSeasonDownload, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="36" MinWidth="142" VerticalAlignment="Bottom"
                                            Margin="10,0,0,10"
                                            ToolTip="Find a verified native source for each numbered episode and keep the completed videos and available captions in your library."/>
                                </WrapPanel>
                                <ProgressBar IsIndeterminate="True"
                                             Height="3"
                                             Visibility="{Binding IsResolvingSources, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding SourceStatusText}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource AccentPrimary}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgPanel}"
                                            BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProviderName}"
                                                               Style="{StaticResource SubtitleText}"
                                                               FontWeight="Bold"/>
                                                    <Border Background="#223B82F6"
                                                            CornerRadius="5"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding AccessModeText}"
                                                                   Foreground="#93C5FD"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding VerificationText}"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#2234D399"
                                                            CornerRadius="5"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsArabicVerified, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="ARABIC VERIFIED"
                                                                   Foreground="#6EE7B7"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UnitText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Foreground="{DynamicResource AccentPrimary}"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding LanguageText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding RightsText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Row="1"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,12,0,0">
                                                <Button Content="External"
                                                        Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        MinWidth="82"
                                                        ToolTip="Open this source outside the app."
                                                        Margin="0,0,8,0"/>
                                                <Button Content="{Binding LibraryDownloadText}"
                                                        Command="{Binding DataContext.DownloadSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        MinWidth="92"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Keep this video file in your download library."/>
                                                <Button Content="Watch via download"
                                                        Command="{Binding DataContext.WatchViaDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        MinWidth="144"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding CanWatchViaDownload, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Download this video, then play it in the app. The temporary file is deleted after its last player tab closes."/>
                                                <Button Content="Open website"
                                                        Command="{Binding DataContext.OpenWebsiteSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        MinWidth="112"
                                                        Visibility="{Binding CanOpenWebsite, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Use the provider website as a fallback."/>
                                                <Button Content="{Binding StreamActionText}"
                                                        Command="{Binding DataContext.PlaySourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="78"
                                                        Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Play this media stream in the built-in player."/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SurfaceCard}"
                                Margin="0,8,0,20"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Downloading video" Style="{StaticResource SubtitleText}" FontWeight="Bold"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercentage}" Height="5" Margin="0,10,0,6"/>
                                <Button Content="Cancel download"
                                        Command="{Binding CancelDownloadCommand}"
                                        Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DownloadStatusText}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
