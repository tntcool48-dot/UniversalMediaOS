<UserControl x:Class="UniversalMediaOS.WPF.Views.MangaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UniversalMediaOS.WPF.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="MangaActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusChrome" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FocusChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FocusChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,10,0"
                        ToolTip="Return to the previous manga view.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentViewMode}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Grid Grid.Column="1">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBox}"
                                     FontSize="15"
                                     Height="44">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchMangaCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Search MangaDex titles..."
                                       Style="{StaticResource SearchPlaceholderText}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"/>
                        </Grid>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Content="Search"
                                AutomationProperties.Name="ExecuteSearch"
                                Command="{Binding SearchMangaCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                MinWidth="112"
                                Margin="10,0,0,0"
                                ToolTip="Search MangaDex for matching manga titles."/>

                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="Cancel"
                                AutomationProperties.Name="Cancel manga search"
                                Command="{Binding SearchMangaCancelCommand}"
                                Style="{StaticResource DangerButton}"
                                Height="44"
                                MinWidth="84"
                                Margin="8,0,0,0"
                                Visibility="{Binding SearchMangaCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Cancel the current manga search."/>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding ResultsDescription}"
                                   Foreground="{StaticResource AccentPrimary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,8,0,0"/>
                    </Grid>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Manga reader" Style="{StaticResource CaptionText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ReaderStatus}" Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Column="2"
                             IsIndeterminate="True"
                             Width="88"
                             Height="4"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentPrimary}"
                             Background="Transparent"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingChapters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingPages}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <Button Grid.Column="2" Content="Retry website" Click="RetryMangaWebsite_Click"
                        Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Visibility="{Binding CanRetryWebsite, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Retry the selected chapter website."/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding MangaResults}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Width="190"
                            Height="338"
                            Margin="0,0,16,16"
                            Style="{StaticResource MangaActionButton}"
                            Command="{Binding DataContext.ReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title, StringFormat=Open {0} chapters}"
                            ToolTip="{Binding Title, StringFormat=Open {0} chapters}">
                        <Button.Effect>
                            <StaticResource ResourceKey="ElevatedPlane"/>
                        </Button.Effect>
                        <Border CornerRadius="8" Background="{StaticResource BgPanelAlt}" ClipToBounds="True" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="228"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Image controls:AsyncImageLoader.ImageUrl="{Binding CoverUrl}"
                                           Stretch="{Binding DataContext.SettingsViewModel.PosterStretch, RelativeSource={RelativeSource AncestorType=Window}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <Border Background="#CC120F1B"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,3"
                                            Margin="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{StaticResource AccentPrimary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="38"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetadataLine}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding GenreLine}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="Open chapters"
                                               Foreground="{StaticResource AccentPrimary}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ListBox ItemsSource="{Binding Chapters}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,10"
                                Command="{Binding DataContext.SelectChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MangaActionButton}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ChapterNumber, StringFormat=Open chapter {0}}"/>
                                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding ChapterNumber, StringFormat=Open chapter {0} website}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Effect>
                                <StaticResource ResourceKey="ElevatedPlane"/>
                            </Button.Effect>
                            <Border Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2414B8A6" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ChapterNumber, StringFormat=Ch. {0}}"
                                                   Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Pages, StringFormat={}{0} pages}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Website only" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="Open website" Foreground="{StaticResource AccentPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding PageUrls}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="1"
                 VirtualizingPanel.CacheLengthUnit="Page">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BgPanel}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Image x:Name="PageImage" controls:AsyncImageLoader.ImageUrl="{Binding}"
                                   controls:AsyncImageLoader.DecodeWidth="1000"
                                   HorizontalAlignment="Center" Stretch="Uniform" MaxWidth="900">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="controls:AsyncImageLoader.HasError" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="Loading page..." Style="{StaticResource CaptionText}" Margin="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ElementName=PageImage, Path=(controls:AsyncImageLoader.IsLoading), Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel MinHeight="140" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ElementName=PageImage, Path=(controls:AsyncImageLoader.HasError), Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="This page could not load." Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                <Button Content="Retry page" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                        Tag="{Binding ElementName=PageImage}" Click="RetryMangaPage_Click"
                                        ToolTip="Retry this page without reloading the chapter."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <wv2:WebView2 x:Name="MangaWebReader" Grid.Row="1">
            <wv2:WebView2.Style>
                <Style TargetType="wv2:WebView2">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="3">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </wv2:WebView2.Style>
        </wv2:WebView2>
    </Grid>
</UserControl>
