<UserControl x:Class="UniversalMediaOS.WPF.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Actions -->
        <Border Grid.Row="0" Background="{StaticResource BgBase}" CornerRadius="8" Margin="0,0,0,24" Padding="{StaticResource SpaceXs}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshDownloadsCommand}" Margin="{StaticResource SpaceSm}" Height="32" Style="{StaticResource PremiumNavButton}"/>
                <Button Content="Open Folder" Command="{Binding OpenDownloadsFolderCommand}" Margin="{StaticResource SpaceSm}" Height="32" Style="{StaticResource PremiumNavButton}"/>
            </StackPanel>
        </Border>

        <!-- Empty State -->
        <TextBlock Grid.Row="1" Text="No downloaded files found." 
                   Style="{StaticResource DisplayText}" Foreground="{StaticResource TextMuted}" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- Downloads Grid -->
        <ListBox Grid.Row="1" ItemsSource="{Binding InstalledFiles}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Outer border carries the drop shadow; inner border clips content -->
                    <Border Background="Transparent" Margin="0,0,0,16">
                        <Border.Effect>
                            <StaticResource ResourceKey="ElevatedPlane"/>
                        </Border.Effect>
                        <Border Background="{StaticResource BgSurface}" CornerRadius="8" Padding="16" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icon/Indicator (Decorative) -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{StaticResource BgBase}" Margin="0,0,16,0">
                                <TextBlock Text="▶" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource TitleText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Content="Delete" 
                                    Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" 
                                    Width="100" Height="36" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="16,0,0,0" Style="{StaticResource PremiumNavButton}"/>

                            <Button Grid.Column="3" Content="Play" 
                                    Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" 
                                    Width="100" Height="36" Background="{StaticResource AccentPrimary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Margin="16,0,0,0" Style="{StaticResource PremiumNavButton}"/>
                        </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
