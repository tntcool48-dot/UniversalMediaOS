<UserControl x:Class="UniversalMediaOS.WPF.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Downloads" Style="{StaticResource DisplayText}" FontSize="24"/>
                    <TextBlock Text="Local episodes, season packs, and readable files ready for playback."
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Command="{Binding RefreshDownloadsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            ToolTip="Rescan the download folder and refresh this list."/>
                    <Button Content="Open folder"
                            Command="{Binding OpenDownloadsFolderCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="120"
                            ToolTip="Open the downloads folder in File Explorer."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCard}"
                Margin="0,0,0,18"
                Visibility="{Binding HasDownloadJobs, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Download queue" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Jobs are saved across restarts. Pause stops the torrent before the worker exits; partial data is kept for resume."
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"/>
                <ListBox ItemsSource="{Binding DownloadJobs}"
                         MaxHeight="300"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="310"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ProgressText}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource AccentPrimary}"
                                                       Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource SubtitleText}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     Height="5" Margin="0,8,0,7"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource AccentPrimary}"/>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusMessage}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Pause"
                                                Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                MinWidth="62" Height="34" Margin="0,0,6,6"/>
                                        <Button Content="Resume"
                                                Command="{Binding DataContext.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="68" Height="34" Margin="0,0,6,6"/>
                                        <Button Content="Cancel"
                                                Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                MinWidth="64" Height="34" Margin="0,0,6,6"/>
                                        <Button Content="Retry"
                                                Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="58" Height="34" Margin="0,0,6,6"/>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                MinWidth="68" Height="34" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource SurfaceCard}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No downloaded files yet" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Queued seasons and local media will appear here after refresh."
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="Progress"
                     AutomationProperties.Name="Progress"
                     ItemsSource="{Binding InstalledFiles}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Margin="0,0,0,12">
                            <Border.Effect>
                                <StaticResource ResourceKey="ElevatedPlane"/>
                            </Border.Effect>
                            <Border Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#2414B8A6" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                                        <TextBlock Text="&#xE768;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource AccentPrimary}"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                                        <TextBlock Text="{Binding FileName}"
                                                   Style="{StaticResource SubtitleText}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileSizeText}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Width="92"
                                            Height="36"
                                            Margin="0,0,8,0"
                                            ToolTip="Delete this local downloaded file."/>

                                    <Button Grid.Column="3"
                                            Content="{Binding OpenActionText}"
                                            Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="92"
                                            Height="36"
                                            ToolTip="Play this downloaded file."/>
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
