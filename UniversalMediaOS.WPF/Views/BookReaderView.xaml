<UserControl x:Class="UniversalMediaOS.WPF.Views.BookReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             Background="{DynamicResource BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Command="{Binding GoBackCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        MinWidth="84"
                        AutomationProperties.Name="Back from Book Reader"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Book.Title}"
                               Style="{DynamicResource SubtitleText}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentChapterTitle}"
                               Style="{DynamicResource CaptionText}"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Previous"
                            Command="{Binding PreviousChapterCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            ToolTip="Go to the previous EPUB chapter or tracked PDF page."/>
                    <Button Content="Next"
                            Command="{Binding NextChapterCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            MinWidth="78"
                            ToolTip="Go to the next EPUB chapter or tracked PDF page."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanelAlt}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Chapters"
                               Style="{DynamicResource SubtitleText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="4,2,4,10"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Chapters}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource SecondaryButton}"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        ToolTip="{Binding Title}">
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="PDF"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Use the app's Previous and Next buttons to keep the saved PDF page accurate. The percentage slider is a manual progress estimate."
                                   Style="{DynamicResource CaptionText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#FFFFFFFF">
                <wv2:WebView2 x:Name="BookWebReader"
                              DefaultBackgroundColor="White"/>

                <Border Background="#D9070A12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="220"
                                     Height="4"
                                     Foreground="{DynamicResource AccentPrimary}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="White"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#F2070A12"
                        Padding="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Text="Reader unavailable"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFCBD5E1"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ProgressText}"
                           Foreground="{DynamicResource AccentPrimary}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           MinWidth="42"/>

                <Slider Grid.Column="2"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        ToolTip="Reading progress percentage"/>

                <Button Grid.Column="4"
                        Content="Save progress"
                        Command="{Binding SaveProgressCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        MinWidth="112"/>
                <Button Grid.Column="6"
                        Content="Mark complete"
                        Command="{Binding MarkCompletedCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        MinWidth="118"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
