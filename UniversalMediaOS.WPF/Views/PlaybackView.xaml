<UserControl x:Class="UniversalMediaOS.WPF.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UniversalMediaOS.WPF.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="#050507"
             Focusable="True"
             PreviewKeyDown="PlaybackRoot_PreviewKeyDown">

    <UserControl.Resources>
        <DataTemplate x:Key="LocalizedTrackLabel">
            <TextBlock Text="{helpers:LocValue Label}" FlowDirection="LeftToRight"/>
        </DataTemplate>
        <Style x:Key="LocalizedTrackItem" TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{helpers:LocValue Label}"/>
        </Style>
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#A6334155"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#64748B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#5EEAD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryControlButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Background" Value="#14B8A6"/>
            <Setter Property="BorderBrush" Value="#2DD4BF"/>
            <Setter Property="Foreground" Value="#031412"/>
        </Style>

        <!-- Native overlays live in a separate HWND: their own visibility must
             follow the selected tab, as well as native/browser playback mode. -->
        <DataTemplate x:Key="PlaybackStateOverlayTemplate">
            <Grid Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWebViewActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTabActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,18"
                        CornerRadius="12"
                        Background="#E6101720"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Visibility="{Binding IsPlaybackBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Width="260">
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Foreground="#2DD4BF"
                                     Background="#334155"/>
                        <TextBlock Text="{helpers:LocValue PlaybackStatusText}"
                                   Margin="0,12,0,0"
                                   Foreground="#F8FAFC"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520"
                        Padding="26,22"
                        CornerRadius="14"
                        Background="#F0101720"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        Visibility="{Binding HasPlaybackError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc Playback problem}"
                                   Foreground="#FCA5A5"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding PlaybackErrorText}"
                                   Margin="0,8,0,18"
                                   Foreground="#E2E8F0"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{helpers:Loc Retry stream}"
                                    Command="{Binding RetryPlaybackCommand}"
                                    Style="{StaticResource PrimaryControlButtonStyle}"
                                    AutomationProperties.Name="Retry playback"/>
                            <Button Content="{helpers:Loc Open browser player}"
                                    Command="{Binding OpenWebFallbackCommand}"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Visibility="{Binding HasWebFallback, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Open browser fallback"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PlaybackRoot"
          Background="#050507"
          ClipToBounds="True"
          MouseMove="PlaybackRoot_MouseMove"
          PreviewMouseDown="PlaybackRoot_PreviewMouseDown"
          PreviewMouseWheel="PlaybackRoot_PreviewMouseWheel">

        <Grid x:Name="VideoSurface"
              Grid.Row="0"
              Background="Black"
              ClipToBounds="True"
              MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown">
            <vlc:VideoView x:Name="VlcPlayer"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch">
                <!-- VideoView places this content above its native HWND. Keep
                     transport controls here so video bounds never depend on them. -->
                <Grid x:Name="NativeOverlay" Background="Transparent" Focusable="True" ClipToBounds="True"
                      FlowDirection="{Binding FlowDirection, Source={x:Static helpers:LocalizationBindingSource.Instance}}"
                      SizeChanged="PlaybackOverlay_SizeChanged"
                      MouseMove="PlaybackRoot_MouseMove"
                      PreviewMouseDown="PlaybackRoot_PreviewMouseDown"
                      PreviewMouseWheel="PlaybackRoot_PreviewMouseWheel"
                      PreviewKeyDown="PlaybackRoot_PreviewKeyDown"
                      MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebViewActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTabActive}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource PlaybackStateOverlayTemplate}"/>
                    <!-- Keep options above the transport and leave native captions
                         their own space. All three panels still overlay the video. -->
                    <Border x:Name="ControlsLayer" Padding="14,10"
                            MouseLeave="ControlsLayer_MouseLeave" Opacity="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TitlePanel" Padding="8,4" CornerRadius="5" Background="#A6050507">
                            <DockPanel Margin="0">
                                <Button DockPanel.Dock="Right" Content="{helpers:Loc Restore}" Click="PictureInPictureButton_Click"
                                        Style="{StaticResource ControlButtonStyle}"
                                        Visibility="{Binding IsPictureInPictureMode, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Exit picture in picture" ToolTip="Restore the app window."/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EpisodeInfo}" Foreground="#CBD5E1"
                                           VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{helpers:LocValue PlaybackStatusText}" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" Foreground="#5EEAD4" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0" ToolTip="{helpers:LocValue PlaybackStatusText}"/>
                                <TextBlock x:Name="MediaTitleText" Text="{Binding MediaTitle}" Foreground="#F8FAFC"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" MouseLeftButtonDown="MediaTitleText_MouseLeftButtonDown"
                                           ToolTip="Drag here to move the picture-in-picture window."/>
                            </DockPanel>
                            </Border>
                            <Grid x:Name="OptionsArea" Grid.Row="1" Margin="0,6,0,8">
                                <Border x:Name="OptionsPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        MaxWidth="850" MaxHeight="{Binding ActualHeight, ElementName=OptionsArea}"
                                        Padding="10" CornerRadius="6" Background="#ED111827">
                            <Expander x:Name="PlaybackOptions" Header="{helpers:Loc Playback options}" IsExpanded="False"
                                      Foreground="#CBD5E1" Margin="0" HorizontalContentAlignment="Stretch"
                                      Expanded="PlaybackOptions_Changed" Collapsed="PlaybackOptions_Changed"
                                      AutomationProperties.Name="{helpers:Loc Playback options}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{helpers:LocValue AudioNotice}" Foreground="#CBD5E1" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AudioNotice}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <WrapPanel>
                                        <ComboBox ItemsSource="{Binding PlaybackRates}" SelectedItem="{Binding PlaybackRate, Mode=TwoWay}"
                                                  Style="{StaticResource CompactComboBox}" Width="72" Height="34" Margin="0,0,8,6"
                                                  AutomationProperties.Name="{helpers:Loc Playback speed}" ToolTip="{helpers:Loc Playback speed}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StringFormat={}{0:0.##}x}" FlowDirection="LeftToRight"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource LocalizedTrackLabel}" ItemContainerStyle="{StaticResource LocalizedTrackItem}" Style="{StaticResource CompactComboBox}" Width="88" Height="34" Margin="0,0,8,6"
                                                  Visibility="{Binding IsQualitySelectionAvailable, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="{helpers:Loc Video quality}" ToolTip="{helpers:Loc Quality advertised by this stream}"/>
                                        <ComboBox ItemsSource="{Binding AudioOptions}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource LocalizedTrackLabel}" ItemContainerStyle="{StaticResource LocalizedTrackItem}" Style="{StaticResource CompactComboBox}" Width="180" Height="34" Margin="0,0,8,6"
                                                  IsEnabled="{Binding AudioTracksAvailable}" AutomationProperties.Name="{helpers:Loc Audio track}" ToolTip="{helpers:Loc Choose audio track}"/>
                                        <Button Content="{helpers:Loc CC}" Command="{Binding ToggleCaptionsCommand}" IsEnabled="{Binding CaptionsAvailable}"
                                                Style="{StaticResource ControlButtonStyle}" Margin="0,0,6,6"
                                                AutomationProperties.Name="{helpers:Loc Toggle subtitles}" ToolTip="{helpers:Loc Turn subtitles on or off; keep the selected language}"/>
                                        <ComboBox ItemsSource="{Binding CaptionOptions}" SelectedItem="{Binding SelectedCaption, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource LocalizedTrackLabel}" ItemContainerStyle="{StaticResource LocalizedTrackItem}" Style="{StaticResource CompactComboBox}" Width="180" Height="34" Margin="0,0,8,6"
                                                  IsEnabled="{Binding CaptionsAvailable}" AutomationProperties.Name="{helpers:Loc Subtitle track}" ToolTip="{helpers:Loc Choose subtitles or turn them off}"/>
                                        <CheckBox Content="{helpers:Loc Auto next}" IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanGoToNextEpisode}" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Content="{helpers:Loc Previous}" Command="{Binding PreviousEpisodeCommand}" IsEnabled="{Binding CanGoToPreviousEpisode}"
                                                Style="{StaticResource ControlButtonStyle}" AutomationProperties.Name="Previous episode"/>
                                        <Button Content="{helpers:Loc Next}" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding CanGoToNextEpisode}"
                                                Style="{StaticResource ControlButtonStyle}" AutomationProperties.Name="Next episode"/>
                                        <Button Content="{helpers:Loc Stop}" Command="{Binding StopCommand}" Style="{StaticResource ControlButtonStyle}"
                                                AutomationProperties.Name="Stop playback"/>
                                    </WrapPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SourceInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                                                 FlowDirection="LeftToRight"
                                                 Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Media URL or local file path"
                                                 ToolTip="Direct media URL or local file path; Enter to open.">
                                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenSourceCommand}"/></TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="{helpers:Loc Open URL}" Command="{Binding OpenSourceCommand}"
                                                Style="{StaticResource PrimaryControlButtonStyle}" Margin="8,0,2,0"
                                                AutomationProperties.Name="Open media URL or path"/>
                                        <Button Grid.Column="2" Content="{helpers:Loc Open File}" Click="OpenMediaFileButton_Click"
                                                Style="{StaticResource ControlButtonStyle}" AutomationProperties.Name="Choose a local media file"/>
                                    </Grid>
                                </StackPanel>
                                </ScrollViewer>
                            </Expander>
                                </Border>
                            </Grid>
                            <Border x:Name="TransportPanel" Grid.Row="2" Padding="8,6" CornerRadius="6"
                                    Background="#D9050507" MouseLeave="ControlsLayer_MouseLeave">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentTimeText}" Foreground="#CBD5E1" FontSize="12"
                                           VerticalAlignment="Center" Width="48"/>
                                <Slider x:Name="PlaybackSlider" Grid.Column="1" Maximum="{Binding PlaybackDuration}"
                                        Value="{Binding PlaybackTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True" Foreground="#14B8A6" Height="22" Margin="8,0"
                                        PreviewMouseLeftButtonDown="PlaybackSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="PlaybackSlider_LostMouseCapture"
                                        AutomationProperties.Name="Seek video" ToolTip="Seek to a position in the video."/>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#CBD5E1" FontSize="12"
                                           VerticalAlignment="Center" TextAlignment="Right" Width="48"/>
                            </Grid>
                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPictureInPictureMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{helpers:Loc Vol}" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Width="90" Minimum="0" Maximum="100"
                                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Foreground="#14B8A6" VerticalAlignment="Center"
                                                AutomationProperties.Name="Playback volume" ToolTip="Adjust playback volume."/>
                                    </StackPanel>
                                    <Button Content="PiP" Click="PictureInPictureButton_Click" Style="{StaticResource ControlButtonStyle}"
                                            AutomationProperties.Name="Toggle picture in picture" ToolTip="Picture in picture (P)"/>
                                    <Button Content="{helpers:Loc Full}" Click="FullscreenButton_Click" Style="{StaticResource ControlButtonStyle}"
                                            AutomationProperties.Name="Toggle fullscreen" ToolTip="Fullscreen (F); Escape to return."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding PlayPauseText}" Command="{Binding TogglePlayPauseCommand}"
                                            Style="{StaticResource PrimaryControlButtonStyle}"
                                            AutomationProperties.Name="Play or pause" ToolTip="Play or pause (Space or K)"/>
                                    <Button Content="-10s" Command="{Binding SkipBackwardCommand}" Style="{StaticResource ControlButtonStyle}"
                                            AutomationProperties.Name="Skip backward 10 seconds" ToolTip="Back 10 seconds (Left arrow)"/>
                                    <Button Content="+30s" Command="{Binding SkipForwardCommand}" Style="{StaticResource ControlButtonStyle}"
                                            AutomationProperties.Name="Skip forward 30 seconds" ToolTip="Forward 30 seconds (Right arrow)"/>
                                </StackPanel>
                            </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>

            <wv2:WebView2CompositionControl x:Name="WebViewPlayer"
                                            Visibility="Collapsed"
                                            MinWidth="1"
                                            MinHeight="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>

            <Grid Visibility="{Binding IsWebViewActive, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{helpers:Loc Exit PiP}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Click="PictureInPictureButton_Click"
                    Style="{StaticResource ControlButtonStyle}"
                    Visibility="{Binding IsPictureInPictureMode, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Exit picture in picture"/>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
