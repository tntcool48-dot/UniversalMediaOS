<UserControl x:Class="UniversalMediaOS.WPF.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Black">
             
    <Grid>
        <!-- Native Video Surface -->
        <vlc:VideoView x:Name="VlcPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <!-- Embedded WebView for web stream endpoints -->
        <wv2:WebView2 x:Name="WebViewPlayer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Cinematic Controls Layer -->
        <Border x:Name="ControlsLayer" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.6"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid VerticalAlignment="Bottom" Margin="{StaticResource SpaceLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Stop" Command="{Binding StopCommand}" 
                        Margin="0,0,16,0" Padding="16,8" Background="Transparent" Foreground="White" BorderThickness="0" Style="{StaticResource PremiumNavButton}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MediaTitle}" Foreground="White" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                    <Slider Maximum="{Binding PlaybackDuration}" Value="{Binding PlaybackTime}" 
                            Foreground="{StaticResource AccentPrimary}" Height="20" Style="{DynamicResource {x:Type Slider}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Auto-Fading Triggers -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ControlsLayer" Storyboard.TargetProperty="Opacity" 
                                         To="1" Duration="{StaticResource MotionStandard}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ControlsLayer" Storyboard.TargetProperty="Opacity" 
                                         To="0" Duration="{StaticResource MotionEmphasized}" BeginTime="0:0:3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
