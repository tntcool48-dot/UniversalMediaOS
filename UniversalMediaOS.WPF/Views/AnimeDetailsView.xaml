<UserControl x:Class="UniversalMediaOS.WPF.Views.AnimeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UniversalMediaOS.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="AudioModeButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#171A24"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4C1D95"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Button Content="Back to search"
                    AutomationProperties.Name="&#x25C0; Back to Search"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left"
                    ToolTip="Return to the anime search tab."/>

            <Border DockPanel.Dock="Right"
                    Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding EpisodeProgressText}" Style="{StaticResource ChipText}"/>
                    <TextBlock Text=" / " Foreground="{StaticResource TextMuted}" Margin="6,0"/>
                    <TextBlock Text="{Binding MalProgressText}" Style="{StaticResource ChipText}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent">
                <Border.Effect>
                    <StaticResource ResourceKey="ElevatedPlane"/>
                </Border.Effect>
                <Border CornerRadius="8" Background="{StaticResource BgPanelAlt}" ClipToBounds="True" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                    <Grid>
                        <Image controls:AsyncImageLoader.ImageUrl="{Binding Media.CoverImageUrl}"
                               Stretch="{Binding DataContext.SettingsViewModel.PosterStretch, RelativeSource={RelativeSource AncestorType=Window}}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border VerticalAlignment="Bottom" Height="140">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#F2070A12" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="18">
                            <TextBlock Text="Now selected" Style="{StaticResource CaptionText}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Media.OfficialTitle}"
                                       Style="{StaticResource SubtitleText}"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       MaxHeight="72"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Media.OfficialTitle}"
                               Style="{StaticResource DisplayText}"
                               FontSize="32"
                               FontWeight="Black"
                               TextWrapping="Wrap"/>

                    <WrapPanel Margin="0,14,0,0">
                        <Border Background="#1E293B" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                            <TextBlock Text="{Binding Media.Id, StringFormat='AniList {0}'}" Style="{StaticResource ChipText}"/>
                        </Border>
                        <Border Background="#1E293B" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Media.IdMal}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Media.IdMal, StringFormat='MAL {0}'}" Style="{StaticResource ChipText}"/>
                        </Border>
                        <Border Background="#2214B8A6" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                            <TextBlock Text="{Binding EpisodeProgressText}" Style="{StaticResource ChipText}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,22,0,18">
                    <StackPanel>
                        <TextBlock Text="Watch Options" Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="Sub"
                                              IsChecked="{Binding IsSubSelected, Mode=TwoWay}"
                                              Style="{StaticResource AudioModeButton}"
                                              ToolTip="Use subbed streams for this media tab."/>
                                <ToggleButton Content="Dub"
                                              IsChecked="{Binding IsDubSelected, Mode=TwoWay}"
                                              Style="{StaticResource AudioModeButton}"
                                              ToolTip="Use dubbed streams for this media tab when available."/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AudioAvailabilityText}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding DubCheckStatus}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                        <Button Content="Cancel Dub check" Command="{Binding CancelDubCheckCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                AutomationProperties.Name="Cancel Dub Availability Check"
                                Visibility="{Binding IsDubChecking, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,12"/>
                        <TextBlock Text="Sources are found automatically. Choose an episode and Sub or Dub, then watch."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Stream episode"
                                    AutomationProperties.Name="&#x26A1; Watch Now"
                                    Command="{Binding WatchNowCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="132"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,10,10"
                                    IsEnabled="{Binding CanWatchSelectedEpisode}"
                                    ToolTip="Find a direct stream for the selected episode in the app. The website is a separate last-resort choice."/>
                            <Button Content="Watch via download"
                                    Command="{Binding WatchViaDownloadCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="160"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,10,10"
                                    IsEnabled="{Binding CanDownloadSelectedEpisode}"
                                    ToolTip="Download only the selected episode from a torrent source, play it here, and remove its temporary files when the player tab closes."/>
                            <Button Content="Cancel download"
                                    Command="{Binding CancelTemporaryWatchCommand}"
                                    Visibility="{Binding IsTemporaryWatchDownloading, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,10,10"
                                    ToolTip="Cancel this temporary episode download and remove its partial files."/>
                            <Button
                                    Content="{Binding DownloadButtonText}"
                                    Command="{Binding DownloadSeasonCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="132"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,10"
                                    ToolTip="Add this season to the persistent download queue. Manage pause, resume, retry, and cancel from Downloads."/>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Prev"
                                        Command="{Binding PreviousEpisodePageCommand}"
                                        IsEnabled="{Binding CanMoveEpisodePagePrevious}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        Margin="0,0,8,0"
                                        ToolTip="Show the previous page of episode buttons."/>
                                <Button Content="Next"
                                        Command="{Binding NextEpisodePageCommand}"
                                        IsEnabled="{Binding CanMoveEpisodePageNext}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        ToolTip="Show the next page of episode buttons."/>
                            </StackPanel>
                            <TextBlock Text="{Binding EpisodePageText}" Style="{StaticResource BodyText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding EpisodeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Number}"
                                            Command="{Binding DataContext.SelectEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsAvailable}"
                                             Width="64"
                                             Height="34"
                                             Margin="0,0,8,8"
                                             ToolTip="{Binding AvailabilityText}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#4C1D95"/>
                                                        <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Synopsis" Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Media.Synopsis}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ProgressBar Grid.Row="3"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,14,0,0"
                             Foreground="{StaticResource AccentPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding IsRouting, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <StackPanel Grid.Column="4">
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="MAL Tracker" Style="{StaticResource SubtitleText}" FontSize="16" FontWeight="Bold"/>
                            <ProgressBar DockPanel.Dock="Right"
                                         IsIndeterminate="True"
                                         Width="54"
                                         Height="4"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsMalStatusLoading, Converter={StaticResource BoolToVisibility}}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding MalProgressText}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Scraper Status" Style="{StaticResource SubtitleText}" FontSize="16" FontWeight="Bold"/>
                            <ProgressBar DockPanel.Dock="Right"
                                         Width="54"
                                         Height="4"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource AccentPrimary}"
                                         Visibility="{Binding IsRouting, Converter={StaticResource BoolToVisibility}}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ScraperStatusHeadline}" Style="{StaticResource BodyText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ScraperStatusDetail}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding ScraperActivityItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding State}" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Timestamp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="Voice discovery" Style="{StaticResource SubtitleText}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Compare the selected anime's cast with voice actors from titles in your library."
                                   Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="Open VA Detect"
                                Command="{Binding OpenVaDetectCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                ToolTip="Find familiar sub or dub voice actors for this anime."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
