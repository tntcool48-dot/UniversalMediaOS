<UserControl x:Class="UniversalMediaOS.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,32"
                       Style="{StaticResource DisplayText}"/>

            <!-- ── Services ─────────────────────────────────────────── -->
            <TextBlock Text="Services" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

            <CheckBox Content="Auto-manage local dependencies (Python scraper, uBlock, FFmpeg check, qBittorrent launch)"
                      IsChecked="{Binding AutoManageServices}"
                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock Text="When enabled, the app prepares local streaming/downloading dependencies on launch and reports non-fatal warnings here."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="24,0,0,24" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Scraper Site Attempts" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ScraperSiteAttemptLimit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2" Text="How many indexed streaming sites Auto mode should try before WebView fallback."
                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="12,0,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ServiceHealthText}" Foreground="{StaticResource TextMuted}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshServiceHealthCommand}"
                            Margin="12,0,0,0" Padding="12,6" VerticalAlignment="Top"
                            Background="{StaticResource AccentPrimary}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- qBittorrent -->
            <TextBlock Text="qBittorrent WebUI" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Host" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitHost, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Port" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitPort, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Username" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Password" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" x:Name="QbitPasswordBox" PasswordChanged="QbitPasswordBox_PasswordChanged"/>
            </Grid>

            <!-- MAL -->
            <TextBlock Text="MyAnimeList Integration" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="OAuth Token" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding MalOAuthToken, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Playback -->
            <TextBlock Text="Playback" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Default Audio" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" SelectedValue="{Binding DefaultAudioPref}" SelectedValuePath="Content">
                    <ComboBoxItem Content="Sub"/>
                    <ComboBoxItem Content="Dub"/>
                </ComboBox>
            </Grid>
            <CheckBox Content="Auto-play after download" IsChecked="{Binding AutoPlayAfterDownload}"
                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

            <!-- ── Downloads ─────────────────────────────────── -->
            <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Download Directory" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" 
                           Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"/>
                <Button    Grid.Column="2" Content="Browse..." Command="{Binding BrowseDownloadDirectoryCommand}"
                           Margin="8,0,0,0" Padding="12,6" Background="{StaticResource AccentPrimary}" 
                           Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- ── Debug & Logging ─────────────────────────────────── -->
            <TextBlock Text="Debug &amp; Logging" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <CheckBox Content="Enable Debug Logging" IsChecked="{Binding EnableDebugLogging}"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock Text="Writes button clicks, network resolve events, and scraper logs to a local file for diagnosis."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="24,0,0,12" TextWrapping="Wrap"/>
            
            <StackPanel Orientation="Horizontal" Margin="24,0,0,32">
                <TextBlock Text="Log File Size: " Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="Medium"/>
                <TextBlock Text="{Binding LogFileSizeText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Clear Log File" Command="{Binding ClearLogCommand}" Padding="12,6" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- ── Custom Web Providers (Tier 3) ────────────────────── -->
            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,16,0,24"/>
            
            <TextBlock Text="Custom Web Providers (WebView2 Fallback)" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
            
            <TextBlock Text="Manage custom websites to load as embeds. The search URL must contain '{query}' where the anime name will be injected."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- Providers List -->
            <ListBox ItemsSource="{Binding CustomSourcesList}" Background="Transparent" BorderThickness="0" Margin="0,0,0,24" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgSurface}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,16,0" TextTrimming="CharacterEllipsis"/>
                                
                                <Button Grid.Column="2" Content="Delete" 
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"
                                        Background="#EF4444" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add Provider Form -->
            <Border Background="{StaticResource BgSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Add New Web Provider" Style="{StaticResource SubtitleText}" FontWeight="Bold"/>
                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Provider Name" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Search URL Template (e.g. https://website.com/search?q={query})" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewSourceUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Grid.Row="4" Content="Add Provider" Command="{Binding AddSourceCommand}"
                            HorizontalAlignment="Right" Padding="16,8" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Save -->
            <Button Content="Save Settings" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left" Padding="24,12"
                    Background="{StaticResource AccentPrimary}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
