<UserControl x:Class="UniversalMediaOS.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,32"
                       Style="{StaticResource DisplayText}"/>

            <!-- ── Services ─────────────────────────────────────────── -->
            <TextBlock Text="Services" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

            <CheckBox Content="Auto-Manage Background Services (Consumet, Python Scraper, qBittorrent)"
                      IsChecked="{Binding AutoManageServices}"
                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock Text="When enabled, the app automatically downloads and starts all required local services on launch."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="24,0,0,24" TextWrapping="Wrap"/>

            <!-- Consumet -->
            <TextBlock Text="Consumet API" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="API Base URL" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding ConsumetApiBase, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Provider" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding ConsumetProvider, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- qBittorrent -->
            <TextBlock Text="qBittorrent WebUI" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Host" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitHost, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Port" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitPort, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Username" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding QbitUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Password" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" x:Name="QbitPasswordBox"/>
            </Grid>

            <!-- MAL -->
            <TextBlock Text="MyAnimeList Integration" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="OAuth Token" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding MalOAuthToken, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Playback -->
            <TextBlock Text="Playback" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Default Audio" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" SelectedItem="{Binding DefaultAudioPref}">
                    <ComboBoxItem Content="Sub"/>
                    <ComboBoxItem Content="Dub"/>
                </ComboBox>
            </Grid>
            <CheckBox Content="Auto-play after download" IsChecked="{Binding AutoPlayAfterDownload}"
                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,32"/>

            <!-- Save -->
            <Button Content="Save Settings" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left" Padding="24,12"
                    Background="{StaticResource AccentPrimary}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
