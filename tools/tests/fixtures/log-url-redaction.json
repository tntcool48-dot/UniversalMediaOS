{
  "description": "Shared contract for LogSanitizer.RedactSensitiveUrls (C#) and redact_log_urls (scraper.py). Both must turn each message into exactly the expected text and drop every secret.",
  "cases": [
    {
      "name": "dotted gzip-base64 route token",
      "message": "Proxy validation OK manifest=https://tmstr4.example.com/pl/H4sIAAAAAAAAAw3JwRKCIBAA0F9iA5zxyqQGjhvYxpqOIjUxm.MTA4MjMyNDU.ZmUwYjE5ZmQ/master.m3u8",
      "expected": "Proxy validation OK manifest=https://tmstr4.example.com/pl/<redacted>/master.m3u8",
      "secrets": ["H4sIAAAAAAAAAw3J", "MTA4MjMyNDU", "ZmUwYjE5ZmQ"]
    },
    {
      "name": "padded base64 route token",
      "message": "Media https://cdn.example.net/stream_new2/H4sIAAAAAAAAAwXBy7JDMBQA0F8iUb1hA0KjfYdh8YkJpqWbX1Ug==/list.m3u8",
      "expected": "Media https://cdn.example.net/stream_new2/<redacted>/list.m3u8",
      "secrets": ["H4sIAAAAAAAAAwXB", "KjfYdh8YkJpqWbX1Ug"]
    },
    {
      "name": "edge-auth token segment",
      "message": "Media https://edge.example.org/hdntl=exp=1792700000~acl=%2f*~data=hdntl~hmac=7f3c0a9be4d2/index.m3u8",
      "expected": "Media https://edge.example.org/<redacted>/index.m3u8",
      "secrets": ["hmac", "7f3c0a9be4d2", "1792700000"]
    },
    {
      "name": "matrix signature keeps the media extension",
      "message": "Media https://cdn.example.io/_v2-lrsp/h/list;15a38634f803584ba8926411d7bee906856cab06.m3u8",
      "expected": "Media https://cdn.example.io/_v2-lrsp/h/<redacted>.m3u8",
      "secrets": ["15a38634f803584b"]
    },
    {
      "name": "JWT route segment",
      "message": "Media https://media.example.com/hls/eyJhbGciOiJIUzI1NiJ9.eyJleHAiOjE3OTI3MDAwMDB9.c2lnbmF0dXJl/master.m3u8",
      "expected": "Media https://media.example.com/hls/<redacted>/master.m3u8",
      "secrets": ["eyJhbGciOiJIUzI1NiJ9", "eyJleHAiOjE3OTI3MDAwMDB9", "c2lnbmF0dXJl"]
    },
    {
      "name": "short signature and expiry named by the route",
      "message": "Media https://cdn.example.com/token/9f2Kq_x7ZpL3/expires/1792700000/master.m3u8",
      "expected": "Media https://cdn.example.com/token/<redacted>/expires/<redacted>/master.m3u8",
      "secrets": ["9f2Kq_x7ZpL3", "1792700000"]
    },
    {
      "name": "encoded upstream URL inside a proxy path",
      "message": "Proxy http://127.0.0.1:41234/proxy/https%3A%2F%2Fcdn.example.com%2Fmaster.m3u8%3Ftoken%3Dabc123secret",
      "expected": "Proxy http://127.0.0.1:41234/proxy/<redacted>",
      "secrets": ["abc123secret", "token"]
    },
    {
      "name": "short hex signature",
      "message": "Media https://cdn.example.com/hls/5c0e04d8b3c8f5e0/1080/index.m3u8",
      "expected": "Media https://cdn.example.com/hls/<redacted>/1080/index.m3u8",
      "secrets": ["5c0e04d8b3c8f5e0"]
    },
    {
      "name": "medium mixed-case token",
      "message": "Media https://cdn.example.com/v/Xk3Jd9aLq0ZmP2vR8tYb4NcW/index.m3u8",
      "expected": "Media https://cdn.example.com/v/<redacted>/index.m3u8",
      "secrets": ["Xk3Jd9aLq0ZmP2vR8tYb4NcW"]
    },
    {
      "name": "signed query values",
      "message": "Media https://cdn.example.com/video/master.m3u8?token=abc&expires=1792700000&signature=deadbeef",
      "expected": "Media https://cdn.example.com/video/master.m3u8?<redacted>",
      "secrets": ["token", "1792700000", "deadbeef"]
    },
    {
      "name": "readable embed route",
      "message": "Embed https://vidsrc.example/embed/tv/tt0903747/1/1",
      "expected": "Embed https://vidsrc.example/embed/tv/tt0903747/1/1",
      "secrets": []
    },
    {
      "name": "readable archive identifiers",
      "message": "Archive https://archive.example.org/download/NightOfTheLivingDead1968/Night_of_the_Living_Dead_1968.mp4",
      "expected": "Archive https://archive.example.org/download/NightOfTheLivingDead1968/Night_of_the_Living_Dead_1968.mp4",
      "secrets": []
    },
    {
      "name": "readable slug route",
      "message": "Watch https://anime.example/watch/frieren-beyond-journeys-end/ep-1",
      "expected": "Watch https://anime.example/watch/frieren-beyond-journeys-end/ep-1",
      "secrets": []
    },
    {
      "name": "readable rendition list",
      "message": "HLS https://cdn.example.com/hls2/01/01234/abcd1234_,l,n,h,.urlset/master.m3u8",
      "expected": "HLS https://cdn.example.com/hls2/01/01234/abcd1234_,l,n,h,.urlset/master.m3u8",
      "secrets": []
    },
    {
      "name": "readable camel-case season route",
      "message": "Season https://catalog.example/TheOfficeSeason1/S01E01-Pilot.mp4",
      "expected": "Season https://catalog.example/TheOfficeSeason1/S01E01-Pilot.mp4",
      "secrets": []
    }
  ]
}
